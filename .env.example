# Build-time (client bundle): the project URL and the PUBLISHABLE (anon) key — never the service-role key.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
# Native shell (capacitor.config.ts): where the hosted web app lives, and the bundle id.
CAP_SERVER_URL=https://map-app.<you>.workers.dev
CAP_APP_ID=gr.innera.mapapp
# Server-side (Worker secrets / vars — `wrangler secret put`, never in the client build, never prefixed VITE_):
#   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, ROUTING_API_KEY (Stadia Maps), ROUTING_BASE_URL (optional)

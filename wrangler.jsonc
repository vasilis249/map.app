{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-app",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true }
  // Secrets / vars (set with `wrangler secret put` or the dashboard, never in this file):
  //   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY (server-side rendering), ROUTING_API_KEY (Phase 4)
}
